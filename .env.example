# You need ONE LLM provider key below, plus a Serper key (for web search).
#
# RECOMMENDED -- genuinely free, no credit card required:
GEMINI_API_KEY=your_gemini_api_key_here
MODEL=gemini/gemini-1.5-flash

# Alternative: OpenAI (requires a paid/prepaid account as of 2026 -- no free trial credits)
# OPENAI_API_KEY=your_openai_api_key_here
# MODEL=gpt-4o-mini

# Alternative: Anthropic (API access requires a paid account)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# MODEL=anthropic/claude-3-5-sonnet-latest

# Required regardless of which LLM you pick -- powers the Searcher agent's
# web search. Free tier, no credit card. Get a key at https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# Optional: set your own default so `python main.py` with no arguments
# researches your preferred company instead of the built-in default
COMPANY_NAME=Notion
FOCUS_AREAS=pricing changes, AI features, recent product launches, main competitors
